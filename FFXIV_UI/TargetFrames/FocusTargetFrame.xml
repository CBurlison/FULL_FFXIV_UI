<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/
                        https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Frame name="FFFocusTargetFrame" parent="UIParent" frameStrata="MEDIUM">
        <Size x="650" y="650"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="bg" file="Interface\AddOns\FFXIV_UI\Media\Textures\TargetFrame\Background">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="215" y="-4"/>
                        <Anchor point="BOTTOMRIGHT" x="-215" y="0"/>
                    </Anchors>
                    <Color r="1" g="0.87" b="0"/>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <StatusBar parentKey="bar">
                <Anchors>
                    <Anchor point="TOPLEFT" x="215" y="-4"/>
                    <Anchor point="BOTTOMRIGHT" x="-215" y="0"/>
                </Anchors>
                <BarTexture file="Interface\AddOns\FFXIV_UI\Media\Textures\TargetFrame\Health"/>
            </StatusBar>
            <Frame parentKey="outlineFrame" frameStrata="MEDIUM" setAllPoints="true" enableMouse="false">
                <Layers>
                    <Layer level="OVERLAY" textureSubLevel="3">
                        <Texture parentKey="outline" file="Interface\AddOns\FFXIV_UI\Media\Textures\TargetFrame\FocusTarget" setAllPoints="true">
                            <Color r="1" g="0.87" b="0"/>
                        </Texture>
                    </Layer>
                    <Layer level="OVERLAY" textureSubLevel="7">
                        <FontString parentKey="nameText" font="Interface\AddOns\FFXIV_UI\Media\Fonts\AxisMedium.ttf" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="LEFT" x="220" y="16"/>
                            </Anchors>
                            <FontHeight val="15"/>
                            <Shadow>
                                <Offset x="1" y="-1"/>
                            </Shadow>
                        </FontString>
                    </Layer>
                </Layers>
                <Frames>
                    <Button parentKey="clickFrame" inherits="SecureUnitButtonTemplate" frameStrata="MEDIUM" enableMouse="true">
                        <Size x="233.3333333333333" y="68"/>
                        <Anchors>
                            <Anchor point="CENTER" x="0" y="5"/>
                        </Anchors>
                    </Button>
                </Frames>
            </Frame>
        </Frames>
    </Frame>
</Ui>
