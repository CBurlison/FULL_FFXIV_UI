<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/
                        https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Frame name="FFPlayerXPFrame" parent="UIParent" frameStrata="MEDIUM">
        <Size x="750" y="750"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture file="Interface\AddOns\FFXIV_UI\Media\Textures\ExperienceBar\XPBG" setAllPoints="true"/>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="restedIndicator" file="Interface\AddOns\FFXIV_UI\Media\Textures\ExperienceBar\FFRested" hidden="true">
                    <Size x="180" y="180"/>
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="RIGHT" x="-75" y="-11"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <StatusBar parentKey="restedBar" setAllPoints="true" hidden="true" minValue="0" maxValue="1" defaultValue="0">
                <BarTexture file="Interface\AddOns\FFXIV_UI\Media\Textures\ExperienceBar\XPRested"/>
            </StatusBar>
            <StatusBar parentKey="xpBar" setAllPoints="true">
                <BarTexture file="Interface\AddOns\FFXIV_UI\Media\Textures\ExperienceBar\XPBar"/>
            </StatusBar>
            <Frame parentKey="outlineFrame" setAllPoints="true">
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="classLabel" font="Interface\AddOns\FFXIV_UI\Media\Fonts\MavenPro-Bold.ttf">
                            <Anchors>
                                <Anchor point="LEFT" x="-5" y="-15"/>
                            </Anchors>
                            <FontHeight val="18"/>
                            <Shadow>
                                <Offset x="1" y="-1"/>
                                <Color r="0.8196" g="0.7804" b="0.6980" a="1"/>
                            </Shadow>
                        </FontString>
                        <FontString parentKey="LLabel" text="L" font="Interface\AddOns\FFXIV_UI\Media\Fonts\MavenPro-Bold.ttf">
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.classLabel" relativePoint="RIGHT" x="4" y="0"/>
                            </Anchors>
                            <FontHeight val="18"/>
                            <Shadow>
                                <Offset x="1" y="-1"/>
                                <Color r="0.8196" g="0.7804" b="0.6980" a="1"/>
                            </Shadow>
                        </FontString>
                        <FontString parentKey="vLabel" text="v" font="Interface\AddOns\FFXIV_UI\Media\Fonts\MavenPro-Bold.ttf">
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.LLabel" x="8" y="0"/>
                            </Anchors>
                            <FontHeight val="18"/>
                            <Shadow>
                                <Offset x="1" y="-1"/>
                                <Color r="0.8196" g="0.7804" b="0.6980" a="1"/>
                            </Shadow>
                        </FontString>
                        <FontString parentKey="levelText" font="Interface\AddOns\FFXIV_UI\Media\Fonts\EurostileExtendedBlack.ttf">
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.vLabel" relativePoint="RIGHT" x="0" y="-1"/>
                            </Anchors>
                            <FontHeight val="18"/>
                            <Shadow>
                                <Offset x="1" y="-1"/>
                                <Color r="0.8196" g="0.7804" b="0.6980" a="1"/>
                            </Shadow>
                        </FontString>
                        <FontString parentKey="xpNumbers" font="Interface\AddOns\FFXIV_UI\Media\Fonts\AxisMedium.ttf">
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.levelText" relativePoint="RIGHT" x="50" y="1"/>
                            </Anchors>
                            <FontHeight val="16"/>
                            <Shadow>
                                <Offset x="0" y="-1"/>
                                <Color r="0.8196" g="0.7804" b="0.6980" a="1"/>
                            </Shadow>
                        </FontString>
                        <FontString parentKey="xpPercent" font="Interface\AddOns\FFXIV_UI\Media\Fonts\AxisMedium.ttf">
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.xpNumbers" relativePoint="RIGHT" x="5" y="0"/>
                            </Anchors>
                            <FontHeight val="16"/>
                            <Shadow>
                                <Offset x="0" y="-1"/>
                                <Color r="0.8196" g="0.7804" b="0.6980" a="1"/>
                            </Shadow>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
    </Frame>
</Ui>
