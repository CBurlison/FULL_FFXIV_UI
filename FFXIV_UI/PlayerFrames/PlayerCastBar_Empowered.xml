<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/
                        https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Frame name="PlayerCastBarEmpoweredFrame" parent="UIParent" frameStrata="MEDIUM" hidden="true">
        <Size x="232" y="230"/>
        <Anchors>
            <Anchor point="CENTER" relativeTo="UIParent" relativePoint="CENTER" x="0" y="0"/>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="bg" file="Interface\AddOns\FFXIV_UI\Media\Textures\PlayerFrame\Background" setAllPoints="true"/>
            </Layer>
        </Layers>
        <Frames>
            <StatusBar parentKey="castBar" minValue="0" maxValue="1" defaultValue="0" hidden="true">
                <Anchors>
                    <Anchor point="TOPLEFT" x="4" y="-4"/>
                    <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
                </Anchors>
                <BarTexture file="Interface\AddOns\FFXIV_UI\Media\Textures\PlayerFrame\ClassResources\Primary\Default"/>
            </StatusBar>
            <Frame parentKey="outlineFrame" frameStrata="MEDIUM">
                <Size x="232" y="230"/>
                <Anchors>
                    <Anchor point="CENTER"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY" textureSubLevel="3">
                        <Texture parentKey="outline" file="Interface\AddOns\FFXIV_UI\Media\Textures\PlayerFrame\Frame" setAllPoints="true"/>
                    </Layer>
                    <Layer level="OVERLAY" textureSubLevel="7">
                        <FontString parentKey="spellText" font="Interface\AddOns\FFXIV_UI\Media\Fonts\AxisRegular.ttf" justifyH="RIGHT">
                            <Anchors>
                                <Anchor point="LEFT" x="3" y="15"/>
                            </Anchors>
                            <FontHeight val="18"/>
                            <Color r="0.9882353" g="0.9843137" b="0.9803922" a="1"/>
                            <Shadow>
                                <Offset x="0" y="-1"/>
                                <Color r="0.8196" g="0.7804" b="0.6980" a="1"/>
                            </Shadow>
                        </FontString>
                        <FontString parentKey="hpLabel" text="CASTING" font="Interface\AddOns\FFXIV_UI\Media\Fonts\MiedingerMedium.ttf" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="BOTTOMLEFT" x="2" y="75"/>
                            </Anchors>
                            <FontHeight val="18"/>
                            <Color r="0.9882353" g="0.9843137" b="0.9803922" a="1"/>
                            <Shadow>
                                <Offset x="0" y="-1"/>
                                <Color r="0.8196" g="0.7804" b="0.6980" a="1"/>
                            </Shadow>
                        </FontString>
                        <FontString parentKey="castTimeText" text="00.00" font="Interface\AddOns\FFXIV_UI\Media\Fonts\EurostileExtended.ttf" justifyH="LEFT">
                            <FontHeight val="32"/>
                            <Color r="0.9882353" g="0.9843137" b="0.9803922" a="1"/>
                            <Shadow>
                                <Offset x="0" y="-1"/>
                                <Color r="0.8196" g="0.7804" b="0.6980" a="1"/>
                            </Shadow>
                        </FontString>
                    </Layer>
                </Layers>
                <Frames>
                    <Button parentKey="spellButton" hidden="true">
                        <Size x="63" y="63"/>
                        <Anchors>
                            <Anchor point="LEFT" x="-65" y="-10"/>
                        </Anchors>
                        <Layers>
                            <Layer level="ARTWORK">
                                <Texture parentKey="icon" setAllPoints="true">
                                    <TexCoords left="0.08" right="0.92" top="0.08" bottom="0.92"/>
                                </Texture>
                            </Layer>
                        </Layers>
                        <Frames>
                            <Cooldown parentKey="cooldown" inherits="CooldownFrameTemplate" setAllPoints="true"/>
                        </Frames>
                    </Button>
                </Frames>
            </Frame>
        </Frames>
    </Frame>
</Ui>
