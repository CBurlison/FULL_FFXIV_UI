<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/
                        https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Button name="PetFrame_HP" inherits="SecureUnitButtonTemplate" parent="UIParent" frameStrata="MEDIUM" hidden="true">
        <Size x="284" y="32"/>
        <Frames>
            <Frame parentKey="visual" setAllPoints="true">
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture parentKey="iconBorder">
                            <Size x="26" y="28"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="0" y="-1"/>
                            </Anchors>
                            <Color r="0.76" g="0.61" b="0.31" a="1"/>
                        </Texture>
                        <Texture parentKey="badge">
                            <Size x="11" y="12"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="33" y="-1"/>
                            </Anchors>
                            <Color r="0.76" g="0.61" b="0.31" a="1"/>
                        </Texture>
                    </Layer>
                    <Layer level="BORDER">
                        <Texture parentKey="iconBackground">
                            <Size x="24" y="26"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="1" y="-2"/>
                            </Anchors>
                            <Color r="0.14" g="0.11" b="0.07" a="1"/>
                        </Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <Texture parentKey="icon">
                            <Size x="20" y="20"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="3" y="-5"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="OVERLAY">
                        <FontString parentKey="order"/>
                        <FontString parentKey="level" justifyH="LEFT">
                            <Size x="32" y="13"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="47" y="-1"/>
                            </Anchors>
                        </FontString>
                        <FontString parentKey="name" justifyH="LEFT">
                            <Size x="180" y="15"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="80" y="0"/>
                            </Anchors>
                        </FontString>
                        <FontString parentKey="healthValue">
                            <Anchors>
                                <Anchor point="TOPRIGHT" relativePoint="TOPLEFT" x="142" y="-22"/>
                            </Anchors>
                        </FontString>
                        <FontString parentKey="powerValue">
                            <Anchors>
                                <Anchor point="TOPRIGHT" relativePoint="TOPLEFT" x="260" y="-22"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            <StatusBar parentKey="health" minValue="0" maxValue="1" defaultValue="0">
                <Size x="108" y="5"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="34" y="-16"/>
                </Anchors>
                <BarTexture file="Interface\Buttons\WHITE8X8"/>
                <Layers>
                    <Layer level="BACKGROUND" textureSubLevel="-2">
                        <Texture parentKey="edge">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="-1" y="1"/>
                                <Anchor point="BOTTOMRIGHT" x="1" y="-1"/>
                            </Anchors>
                            <Color r="0.05" g="0.22" b="0.3" a="0.9"/>
                        </Texture>
                    </Layer>
                    <Layer level="BACKGROUND" textureSubLevel="-1">
                        <Texture parentKey="background" setAllPoints="true">
                            <Color r="0.02" g="0.07" b="0.1" a="0.9"/>
                        </Texture>
                    </Layer>
                    <Layer level="OVERLAY">
                        <Texture parentKey="shine">
                            <Size y="1"/>
                            <Anchors>
                                <Anchor point="TOPLEFT"/>
                                <Anchor point="TOPRIGHT"/>
                            </Anchors>
                            <Color r="0.75" g="0.94" b="1" a="0.65"/>
                        </Texture>
                    </Layer>
                </Layers>
            </StatusBar>
            <StatusBar parentKey="power" minValue="0" maxValue="1" defaultValue="0">
                <Size x="108" y="5"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="152" y="-16"/>
                </Anchors>
                <BarTexture file="Interface\Buttons\WHITE8X8"/>
                <Layers>
                    <Layer level="BACKGROUND" textureSubLevel="-2">
                        <Texture parentKey="edge">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="-1" y="1"/>
                                <Anchor point="BOTTOMRIGHT" x="1" y="-1"/>
                            </Anchors>
                            <Color r="0.05" g="0.22" b="0.3" a="0.9"/>
                        </Texture>
                    </Layer>
                    <Layer level="BACKGROUND" textureSubLevel="-1">
                        <Texture parentKey="background" setAllPoints="true">
                            <Color r="0.02" g="0.07" b="0.1" a="0.9"/>
                        </Texture>
                    </Layer>
                    <Layer level="OVERLAY">
                        <Texture parentKey="shine">
                            <Size y="1"/>
                            <Anchors>
                                <Anchor point="TOPLEFT"/>
                                <Anchor point="TOPRIGHT"/>
                            </Anchors>
                            <Color r="0.75" g="0.94" b="1" a="0.65"/>
                        </Texture>
                    </Layer>
                </Layers>
            </StatusBar>
        </Frames>
    </Button>
</Ui>
