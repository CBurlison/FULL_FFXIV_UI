<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/
                        https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Frame name="PlayerFrame_Power" parent="UIParent" frameStrata="MEDIUM">
        <Size x="232" y="230"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="bg" file="Interface\AddOns\FFXIV_UI\Media\Textures\PlayerFrame\Background" setAllPoints="true"/>
            </Layer>
        </Layers>
        <Frames>
            <StatusBar parentKey="bar">
                <Anchors>
                    <Anchor point="TOPLEFT" x="4" y="-4"/>
                    <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
                </Anchors>
                <BarTexture file="Interface\AddOns\FFXIV_UI\Media\Textures\PlayerFrame\Health"/>
            </StatusBar>
            <Frame parentKey="outlineFrame" frameStrata="MEDIUM">
                <Size x="232" y="230"/>
                <Anchors>
                    <Anchor point="CENTER"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY" textureSubLevel="3">
                        <Texture parentKey="outline" file="Interface\AddOns\FFXIV_UI\Media\Textures\PlayerFrame\Frame" setAllPoints="true"/>
                    </Layer>
                    <Layer level="OVERLAY" textureSubLevel="7">
                        <FontString parentKey="text" font="Interface\AddOns\FFXIV_UI\Media\Fonts\EurostileExtended.ttf" justifyH="RIGHT">
                            <Anchors>
                                <Anchor point="BOTTOMRIGHT" x="-4" y="76"/>
                            </Anchors>
                            <FontHeight val="30"/>
                            <Color r="0.9882353" g="0.9843137" b="0.9803922" a="1"/>
                            <Shadow>
                                <Offset x="0" y="-1"/>
                                <Color r="0.8196" g="0.7804" b="0.6980" a="1"/>
                            </Shadow>
                        </FontString>
                        <FontString parentKey="powerLabel" text="MP" font="Interface\AddOns\FFXIV_UI\Media\Fonts\MiedingerMedium.ttf" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="BOTTOMLEFT" x="2" y="80"/>
                            </Anchors>
                            <FontHeight val="18"/>
                            <Color r="0.9882353" g="0.9843137" b="0.9803922" a="1"/>
                            <Shadow>
                                <Offset x="0" y="-1"/>
                                <Color r="0.8196" g="0.7804" b="0.6980" a="1"/>
                            </Shadow>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
        </Frames>
    </Frame>
</Ui>
