<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/
                        https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Frame name="Playerframe_HP" parent="UIParent" frameStrata="MEDIUM">
        <Size x="232" y="230"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="bg" file="Interface\AddOns\FFXIV_UI\Media\Textures\PlayerFrame\Background" setAllPoints="true"/>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="combatTexture" file="Interface\AddOns\FFXIV_UI\Media\Textures\PlayerFrame\FFInCombat" hidden="true">
                    <Size x="105" y="105"/>
                    <Anchors>
                        <Anchor point="LEFT" x="-35" y="15"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="outOfCombatTexture" file="Interface\AddOns\FFXIV_UI\Media\Textures\PlayerFrame\FFOutOfCombat">
                    <Size x="105" y="105"/>
                    <Anchors>
                        <Anchor point="LEFT" x="-35" y="15"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <StatusBar parentKey="bar">
                <Anchors>
                    <Anchor point="TOPLEFT" x="4" y="-4"/>
                    <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
                </Anchors>
                <BarTexture file="Interface\AddOns\FFXIV_UI\Media\Textures\PlayerFrame\Health"/>
            </StatusBar>
            <StatusBar parentKey="cutawayBar">
                <Anchors>
                    <Anchor point="TOPLEFT" x="4" y="-4"/>
                    <Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
                </Anchors>
                <BarTexture file="Interface\AddOns\FFXIV_UI\Media\Textures\PlayerFrame\Cutaway"/>
            </StatusBar>
            <Frame parentKey="outlineFrame" frameStrata="MEDIUM">
                <Size x="232" y="230"/>
                <Anchors>
                    <Anchor point="CENTER"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY" textureSubLevel="3">
                        <Texture parentKey="outline" file="Interface\AddOns\FFXIV_UI\Media\Textures\PlayerFrame\Frame" setAllPoints="true"/>
                    </Layer>
                    <Layer level="OVERLAY" textureSubLevel="7">
                        <FontString parentKey="text" font="Interface\AddOns\FFXIV_UI\Media\Fonts\EurostileExtended.ttf" justifyH="RIGHT">
                            <Anchors>
                                <Anchor point="BOTTOMRIGHT" x="-4" y="76"/>
                            </Anchors>
                            <FontHeight val="30"/>
                            <Color r="0.9882353" g="0.9843137" b="0.9803922" a="1"/>
                            <Shadow>
                                <Offset x="0" y="-1"/>
                                <Color r="0.8196" g="0.7804" b="0.6980" a="1"/>
                            </Shadow>
                        </FontString>
                        <FontString parentKey="hpLabel" text="HP" font="Interface\AddOns\FFXIV_UI\Media\Fonts\MiedingerMedium.ttf" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="BOTTOMLEFT" x="2" y="80"/>
                            </Anchors>
                            <FontHeight val="18"/>
                            <Color r="0.9882353" g="0.9843137" b="0.9803922" a="1"/>
                            <Shadow>
                                <Offset x="0" y="-1"/>
                                <Color r="0.8196" g="0.7804" b="0.6980" a="1"/>
                            </Shadow>
                        </FontString>
                    </Layer>
                </Layers>
                <Frames>
                    <Button parentKey="clickFrame" inherits="SecureUnitButtonTemplate" frameStrata="MEDIUM">
                        <Size x="240" y="48"/>
                        <Anchors>
                            <Anchor point="CENTER" x="0" y="-10"/>
                        </Anchors>
                    </Button>
                </Frames>
            </Frame>
        </Frames>
    </Frame>
</Ui>
